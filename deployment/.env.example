# Copy to .env beside compose.yaml. Linux amd64; PostgreSQL is required.
COMPOSE_PROJECT_NAME=darkspin
DARKSPIN_ADVERTISED_HOST=192.0.2.10
DARKSPIN_PORT=42127

# Writable directory for binaries, settings, content cache and appearance files.
DARKSPIN_HOME_PATH=./darkspin
# Required complete build-103 installation containing DarksporeBin/ and Data/.
# Mounted read-only; generated content rebuilds automatically in the runtime.
DARKSPIN_GAME_HOST_PATH=

# Shared by PostgreSQL initialization and Darkrun's client connection.
POSTGRES_DB=darkspin
POSTGRES_USER=darkspin
# Required: set a long, unique password. Single quotes preserve literal '$'.
POSTGRES_PASSWORD=
# Initialization applies only to an empty database volume. Changing these
# settings does not change an existing database or role's password.
# Player data persists in the project-scoped postgres_data Docker volume.
# Keep COMPOSE_PROJECT_NAME stable; never use down -v to preserve that data.

# Optional overrides saved to runtime/darkspin.toml [bootstrap].
# Empty/omitted settings reuse saved values; defaults are shown below.
# DARKSPIN_IS_UPDATE_ENABLED=true
# DARKSPIN_UPDATE_CRON="30 3 * * *"
# DARKSPIN_UPDATE_WARNING_MINUTES=30
# DARKSPIN_UPDATE_START_TIMEOUT_SECONDS=1800
# DARKSPIN_BACKUP_RETENTION_DAYS=7
# Initial download and scheduled binary update feed.
# DARKSPIN_UPDATE_MANIFEST_URL=https://nightly.link/darkspinnet/darkspin/workflows/main-build/main/darkrun-update-linux-amd64-unstable.zip
